#!/bin/sh
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if command -v node >/dev/null 2>&1; then
  app_node=$(command -v node)
else
  app_node="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"
fi
if [ ! -x "$app_node" ]; then
  echo 'Node.js >=22.12 is required. Install Node.js or use the bundled Codex runtime.' >&2
  exit 1
fi
cd "$project_dir"
app_action=${1:-dev}
if [ "$#" -gt 0 ]; then shift; fi
case "$app_action" in
  dev) exec "$app_node" node_modules/vite/bin/vite.js --host 127.0.0.1 "$@" ;;
  build) exec "$app_node" node_modules/vite/bin/vite.js build "$@" ;;
  preview) exec "$app_node" node_modules/vite/bin/vite.js preview --host 127.0.0.1 "$@" ;;
  test) exec "$app_node" --experimental-strip-types --test tests/*.test.mjs "$@" ;;
  typecheck) exec "$app_node" node_modules/typescript/bin/tsc --noEmit "$@" ;;
  *) echo "Unknown application command: $app_action" >&2; exit 1 ;;
esac
